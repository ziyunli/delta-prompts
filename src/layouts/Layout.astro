---
// ABOUTME: Base layout component for all pages.
// ABOUTME: Includes global styles, meta tags, and page structure.

interface Props {
  title?: string;
}

const { title = 'delta-prompts' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Compare LLM system prompts across versions with word-level diff highlighting"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="container">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
